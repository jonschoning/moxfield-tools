{
  "name": "moxfield-tools",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "shx rm -rf dist *.tsbuildinfo && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js  && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "tsc --noEmit && eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "watch": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --watch",
    "main": "tsx src/main.ts",
    "saveDecks": "tsx src/main.ts saveDecks",
    "savePublicDeck": "tsx src/main.ts savePublicDeck",
    "exportDecks": "tsx src/main.ts exportDecks"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^2.8.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "esbuild": "^0.28.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "shx": "^0.4.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@stdlib/stats-base-dists-hypergeometric-cdf": "^0.2.1",
    "dotenv": "^17.4.2",
    "got": "^15.1.0",
    "js-yaml": "^5.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
